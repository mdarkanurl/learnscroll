{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "paths": {
      "#auth": ["./src/modules/auth/index.ts"],
      "#error": ["./src/shared/errors/index.ts"],
      "#configs": ["./src/shared/configs/index.ts"],
      "#db": ["./src/shared/database/index.ts"],
      "#redis": ["./src/shared/redis/index.ts"],
      "#validation": ["./src/shared/validation/index.ts"],
      "#rabbitmq": ["./src/shared/rabbitmq/index.ts"],
      "#queue": ["./src/shared/queue/index.ts"]
    }
  }
}
